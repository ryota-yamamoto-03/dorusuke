generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  xUrl      String?
  createdAt DateTime @default(now())
  lives     Live[]
}

model Live {
  id        String   @id @default(cuid())
  liveName  String
  idolName  String
  date      DateTime
  venue     String
  area      String
  link      String
  createdBy String
  user      User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
}
