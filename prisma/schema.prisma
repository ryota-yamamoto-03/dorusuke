generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Live {
  id            String    @id @default(cuid())
  liveName      String
  idolName      String
  date          DateTime?
  dateUndecided Boolean   @default(false)
  venue         String
  area          String
  link          String
  posterName    String?
  xUrl          String?
  createdAt     DateTime  @default(now())
}
